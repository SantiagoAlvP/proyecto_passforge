# Copia este archivo como .env y ajusta los valores.
# .env está en .gitignore: NUNCA lo subas al repositorio.

# development | testing | production  (si no se define: production)
APP_ENV=development

# Dirección y puerto del servidor de desarrollo.
# Se usa 8000 porque en macOS el 5000 lo ocupa AirPlay Receiver.
HOST=127.0.0.1
PORT=8000

# Orígenes (frontend) autorizados a llamar a la API, separados por comas.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

LOG_LEVEL=DEBUG

# Límite general de peticiones por IP y almacenamiento del contador.
# En producción con varias instancias usar Redis, p. ej. redis://redis:6379
RATELIMIT_DEFAULT=60/minute
RATELIMIT_STORAGE_URI=memory://

# true solo si la app está detrás de un proxy de confianza (nginx).
TRUST_PROXY=false
